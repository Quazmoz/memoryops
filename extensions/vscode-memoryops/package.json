{
  "name": "memoryops-vscode",
  "displayName": "MemoryOps",
  "description": "Bring governed MemoryOps agent memory into VS Code.",
  "version": "0.0.1",
  "publisher": "quazmoz",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "memoryops",
    "ai agents",
    "mcp",
    "memory",
    "devops"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memoryops",
          "title": "MemoryOps",
          "icon": "media/memoryops.svg"
        }
      ]
    },
    "views": {
      "memoryops": [
        {
          "id": "memoryops.memories",
          "name": "Memories",
          "contextualTitle": "MemoryOps Memories"
        }
      ]
    },
    "commands": [
      {
        "command": "memoryops.testConnection",
        "title": "MemoryOps: Test Connection",
        "category": "MemoryOps",
        "icon": "$(plug)"
      },
      {
        "command": "memoryops.refreshMemories",
        "title": "MemoryOps: Refresh Memories",
        "category": "MemoryOps",
        "icon": "$(refresh)"
      },
      {
        "command": "memoryops.searchMemory",
        "title": "MemoryOps: Search Memory",
        "category": "MemoryOps",
        "icon": "$(search)"
      },
      {
        "command": "memoryops.retrieveContextForCurrentFile",
        "title": "MemoryOps: Retrieve Context for Current File",
        "category": "MemoryOps",
        "icon": "$(references)"
      },
      {
        "command": "memoryops.saveSelectionAsObservation",
        "title": "MemoryOps: Save Selection as Observation",
        "category": "MemoryOps",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "memoryops.openMemory",
        "title": "MemoryOps: Open Memory",
        "category": "MemoryOps",
        "icon": "$(go-to-file)"
      },
      {
        "command": "memoryops.pinMemory",
        "title": "MemoryOps: Pin Memory",
        "category": "MemoryOps",
        "icon": "$(pinned)"
      },
      {
        "command": "memoryops.unpinMemory",
        "title": "MemoryOps: Unpin Memory",
        "category": "MemoryOps",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "memoryops.deleteMemory",
        "title": "MemoryOps: Delete Memory",
        "category": "MemoryOps",
        "icon": "$(trash)"
      },
      {
        "command": "memoryops.copyMemory",
        "title": "MemoryOps: Copy Memory Content",
        "category": "MemoryOps",
        "icon": "$(copy)"
      },
      {
        "command": "memoryops.openSettings",
        "title": "MemoryOps: Open Settings",
        "category": "MemoryOps",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "memoryops.refreshMemories",
          "when": "view == memoryops.memories",
          "group": "navigation@1"
        },
        {
          "command": "memoryops.searchMemory",
          "when": "view == memoryops.memories",
          "group": "navigation@2"
        },
        {
          "command": "memoryops.retrieveContextForCurrentFile",
          "when": "view == memoryops.memories",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "memoryops.openMemory",
          "when": "view == memoryops.memories && viewItem =~ /memoryops.memory/",
          "group": "inline@1"
        },
        {
          "command": "memoryops.pinMemory",
          "when": "view == memoryops.memories && viewItem == memoryops.memory.unpinned",
          "group": "inline@2"
        },
        {
          "command": "memoryops.unpinMemory",
          "when": "view == memoryops.memories && viewItem == memoryops.memory.pinned",
          "group": "inline@2"
        },
        {
          "command": "memoryops.copyMemory",
          "when": "view == memoryops.memories && viewItem =~ /memoryops.memory/",
          "group": "2_edit@1"
        },
        {
          "command": "memoryops.deleteMemory",
          "when": "view == memoryops.memories && viewItem =~ /memoryops.memory/",
          "group": "9_destructive@1"
        }
      ]
    },
    "configuration": {
      "title": "MemoryOps",
      "properties": {
        "memoryops.apiUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL for the MemoryOps API."
        },
        "memoryops.workspaceId": {
          "type": "string",
          "default": "",
          "description": "MemoryOps workspace UUID."
        },
        "memoryops.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "MemoryOps workspace API key. Store this in user settings, not checked-in workspace settings."
        },
        "memoryops.defaultTopK": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Default number of memories to request for search/retrieval commands."
        },
        "memoryops.defaultSearchMode": {
          "type": "string",
          "default": "hybrid",
          "enum": [
            "hybrid",
            "keyword",
            "vector"
          ],
          "description": "Default retrieval/search mode for MemoryOps commands."
        },
        "memoryops.defaultTokenBudget": {
          "type": "number",
          "default": 2048,
          "minimum": 256,
          "maximum": 16000,
          "description": "Default token budget for retrieval context requests."
        },
        "memoryops.sidebarPageSize": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of recent memories to load in the MemoryOps sidebar."
        },
        "memoryops.includeWorkspacePool": {
          "type": "boolean",
          "default": false,
          "description": "Include workspace-published memories when searching and retrieving context."
        },
        "memoryops.defaultAgentId": {
          "type": "string",
          "default": "vscode",
          "description": "Agent identifier used when saving observations from VS Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
