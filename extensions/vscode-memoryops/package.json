{
  "name": "memoryops-vscode",
  "displayName": "MemoryOps",
  "description": "Bring governed MemoryOps agent memory into VS Code.",
  "version": "1.0.5",
  "publisher": "quazmoz",
  "author": {
    "name": "Quazmoz",
    "url": "https://github.com/Quazmoz"
  },
  "icon": "media/memoryops.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quazmoz/memoryops.git"
  },
  "homepage": "https://github.com/Quazmoz/memoryops",
  "bugs": {
    "url": "https://github.com/Quazmoz/memoryops/issues"
  },
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "memoryops",
    "ai agents",
    "mcp",
    "memory",
    "devops"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "memoryops",
          "title": "MemoryOps",
          "icon": "media/memoryops.svg"
        }
      ]
    },
    "views": {
      "memoryops": [
        {
          "type": "webview",
          "id": "memoryops.memories",
          "name": "Memories",
          "contextualTitle": "MemoryOps Memories"
        },
        {
          "id": "memoryops.skills",
          "name": "Skills",
          "contextualTitle": "MemoryOps Skills"
        },
        {
          "type": "webview",
          "id": "memoryops.contradictions",
          "name": "Contradictions",
          "contextualTitle": "MemoryOps Contradictions"
        }
      ]
    },
    "commands": [
      {
        "command": "memoryops.testConnection",
        "title": "MemoryOps: Test Connection",
        "category": "MemoryOps",
        "icon": "$(plug)"
      },
      {
        "command": "memoryops.refreshMemories",
        "title": "MemoryOps: Refresh Memories",
        "category": "MemoryOps",
        "icon": "$(refresh)"
      },
      {
        "command": "memoryops.searchMemory",
        "title": "MemoryOps: Search Memory",
        "category": "MemoryOps",
        "icon": "$(search)"
      },
      {
        "command": "memoryops.retrieveContextForCurrentFile",
        "title": "MemoryOps: Retrieve Context for Current File",
        "category": "MemoryOps",
        "icon": "$(references)"
      },
      {
        "command": "memoryops.saveSelectionAsObservation",
        "title": "MemoryOps: Save Selection as Observation",
        "category": "MemoryOps",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "memoryops.openMemory",
        "title": "MemoryOps: Open Memory",
        "category": "MemoryOps",
        "icon": "$(go-to-file)"
      },
      {
        "command": "memoryops.promoteMemory",
        "title": "MemoryOps: Promote Memory",
        "category": "MemoryOps",
        "icon": "$(arrow-up)"
      },
      {
        "command": "memoryops.publishMemory",
        "title": "MemoryOps: Publish Memory To Workspace",
        "category": "MemoryOps",
        "icon": "$(globe)"
      },
      {
        "command": "memoryops.viewMemoryHistory",
        "title": "MemoryOps: View Memory History",
        "category": "MemoryOps",
        "icon": "$(history)"
      },
      {
        "command": "memoryops.viewMemoryProvenance",
        "title": "MemoryOps: View Memory Provenance",
        "category": "MemoryOps",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "memoryops.viewMemoryFeedback",
        "title": "MemoryOps: View Memory Feedback",
        "category": "MemoryOps",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "memoryops.pinMemory",
        "title": "MemoryOps: Pin Memory",
        "category": "MemoryOps",
        "icon": "$(pinned)"
      },
      {
        "command": "memoryops.unpinMemory",
        "title": "MemoryOps: Unpin Memory",
        "category": "MemoryOps",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "memoryops.deleteMemory",
        "title": "MemoryOps: Delete Memory",
        "category": "MemoryOps",
        "icon": "$(trash)"
      },
      {
        "command": "memoryops.copyMemory",
        "title": "MemoryOps: Copy Memory Content",
        "category": "MemoryOps",
        "icon": "$(copy)"
      },
      {
        "command": "memoryops.openSettings",
        "title": "MemoryOps: Open Settings",
        "category": "MemoryOps",
        "icon": "$(settings-gear)"
      },
      {
        "command": "memoryops.editMemory",
        "title": "MemoryOps: Edit Memory",
        "category": "MemoryOps",
        "icon": "$(edit)"
      },
      {
        "command": "memoryops.submitFeedback",
        "title": "MemoryOps: Submit Retrieval Feedback",
        "category": "MemoryOps",
        "icon": "$(feedback)"
      },
      {
        "command": "memoryops.insertContext",
        "title": "MemoryOps: Insert Retrieval Context",
        "category": "MemoryOps",
        "icon": "$(arrow-down)"
      },
      {
        "command": "memoryops.copyContext",
        "title": "MemoryOps: Copy Retrieval Context",
        "category": "MemoryOps",
        "icon": "$(copy)"
      },
      {
        "command": "memoryops.setFilterSort",
        "title": "MemoryOps: Filter and Sort Sidebar",
        "category": "MemoryOps",
        "icon": "$(filter)"
      },
      {
        "command": "memoryops.mergeMemory",
        "title": "MemoryOps: Merge Memory",
        "category": "MemoryOps",
        "icon": "$(git-merge)"
      },
      {
        "command": "memoryops.bulkOperations",
        "title": "MemoryOps: Bulk Operations",
        "category": "MemoryOps",
        "icon": "$(checklist)"
      },
      {
        "command": "memoryops.setApiKey",
        "title": "MemoryOps: Set API Key (Secure)",
        "category": "MemoryOps",
        "icon": "$(key)"
      },
      {
        "command": "memoryops.reconnect",
        "title": "MemoryOps: Reconnect",
        "category": "MemoryOps",
        "icon": "$(debug-restart)"
      },
      {
        "command": "memoryops.showMemoriesForFile",
        "title": "MemoryOps: Show Memories Referencing Current File",
        "category": "MemoryOps",
        "icon": "$(references)"
      },
      {
        "command": "memoryops.openWalkthrough",
        "title": "MemoryOps: Open Getting Started Walkthrough",
        "category": "MemoryOps",
        "icon": "$(rocket)"
      },
      {
        "command": "memoryops.skills.list",
        "title": "MemoryOps: List Skills",
        "category": "MemoryOps",
        "icon": "$(symbol-method)"
      },
      {
        "command": "memoryops.skills.create",
        "title": "MemoryOps: Create Skill",
        "category": "MemoryOps",
        "icon": "$(add)"
      },
      {
        "command": "memoryops.skills.toggleEnabled",
        "title": "MemoryOps: Toggle Skill Enabled",
        "category": "MemoryOps",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "memoryops.skills.delete",
        "title": "MemoryOps: Delete Skill",
        "category": "MemoryOps",
        "icon": "$(trash)"
      },
      {
        "command": "memoryops.skills.test",
        "title": "MemoryOps: Test Skill",
        "category": "MemoryOps",
        "icon": "$(beaker)"
      },
      {
        "command": "memoryops.skills.viewHistory",
        "title": "MemoryOps: View Skill Version History",
        "category": "MemoryOps",
        "icon": "$(history)"
      },
      {
        "command": "memoryops.skills.rollback",
        "title": "MemoryOps: Roll Back Skill Version",
        "category": "MemoryOps",
        "icon": "$(discard)"
      },
      {
        "command": "memoryops.skills.syncAgentSkills",
        "title": "MemoryOps: Sync Agent Skills",
        "category": "MemoryOps",
        "icon": "$(sync)"
      },
      {
        "command": "memoryops.skills.invoke",
        "title": "MemoryOps: Invoke Skill",
        "category": "MemoryOps",
        "icon": "$(play)"
      },
      {
        "command": "memoryops.skills.viewInvocations",
        "title": "MemoryOps: View Skill Invocations",
        "category": "MemoryOps",
        "icon": "$(list-unordered)"
      },
      {
        "command": "memoryops.configureFromLocal",
        "title": "MemoryOps: Configure from Local Config File",
        "category": "MemoryOps",
        "icon": "$(gear)"
      },
      {
        "command": "memoryops.agentSkills.viewHistory",
        "title": "MemoryOps: View Agent Skill Version History",
        "category": "MemoryOps",
        "icon": "$(history)"
      },
      {
        "command": "memoryops.agentSkills.rollback",
        "title": "MemoryOps: Roll Back Agent Skill Version",
        "category": "MemoryOps",
        "icon": "$(discard)"
      },
      {
        "command": "memoryops.refreshContradictions",
        "title": "MemoryOps: Refresh Contradictions",
        "category": "MemoryOps",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "memoryops.searchMemory",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "memoryops.saveSelectionAsObservation",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s",
        "when": "editorHasSelection"
      },
      {
        "command": "memoryops.retrieveContextForCurrentFile",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "memoryops.saveSelectionAsObservation",
          "when": "editorHasSelection"
        },
        {
          "command": "memoryops.retrieveContextForCurrentFile",
          "when": "editorIsOpen"
        },
        {
          "command": "memoryops.insertContext",
          "when": "editorIsOpen"
        },
        {
          "command": "memoryops.showMemoriesForFile",
          "when": "editorIsOpen"
        }
      ],
      "view/title": [
        {
          "command": "memoryops.refreshMemories",
          "when": "view == memoryops.memories",
          "group": "navigation@1"
        },
        {
          "command": "memoryops.searchMemory",
          "when": "view == memoryops.memories",
          "group": "navigation@2"
        },
        {
          "command": "memoryops.retrieveContextForCurrentFile",
          "when": "view == memoryops.memories",
          "group": "navigation@3"
        },
        {
          "command": "memoryops.setFilterSort",
          "when": "view == memoryops.memories",
          "group": "navigation@4"
        },
        {
          "command": "memoryops.bulkOperations",
          "when": "view == memoryops.memories",
          "group": "navigation@5"
        },
        {
          "command": "memoryops.skills.create",
          "when": "view == memoryops.skills",
          "group": "navigation@1"
        },
        {
          "command": "memoryops.skills.syncAgentSkills",
          "when": "view == memoryops.skills",
          "group": "navigation@2"
        },
        {
          "command": "memoryops.refreshContradictions",
          "when": "view == memoryops.contradictions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "memoryops.skills.toggleEnabled",
          "when": "view == memoryops.skills && viewItem =~ /memoryops.skill/",
          "group": "inline@1"
        },
        {
          "command": "memoryops.skills.test",
          "when": "view == memoryops.skills && viewItem =~ /memoryops.skill.enabled/",
          "group": "inline@2"
        },
        {
          "command": "memoryops.skills.invoke",
          "when": "view == memoryops.skills && viewItem =~ /memoryops.skill.enabled/",
          "group": "inline@3"
        },
        {
          "command": "memoryops.skills.viewHistory",
          "when": "view == memoryops.skills && viewItem =~ /memoryops.skill/",
          "group": "inline@4"
        },
        {
          "command": "memoryops.skills.viewInvocations",
          "when": "view == memoryops.skills && viewItem =~ /memoryops.skill/",
          "group": "inline@5"
        },
        {
          "command": "memoryops.skills.delete",
          "when": "view == memoryops.skills && viewItem =~ /memoryops.skill/",
          "group": "inline@6"
        },
        {
          "command": "memoryops.agentSkills.viewHistory",
          "when": "view == memoryops.skills && viewItem == memoryops.agentSkill",
          "group": "inline@1"
        },
        {
          "command": "memoryops.agentSkills.rollback",
          "when": "view == memoryops.skills && viewItem == memoryops.agentSkill",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "memoryops.saveSelectionAsObservation",
          "when": "editorHasSelection",
          "group": "memoryops@1"
        },
        {
          "command": "memoryops.retrieveContextForCurrentFile",
          "when": "editorFocus",
          "group": "memoryops@2"
        },
        {
          "command": "memoryops.showMemoriesForFile",
          "when": "editorFocus",
          "group": "memoryops@3"
        }
      ]
    },
    "configuration": {
      "title": "MemoryOps",
      "properties": {
        "memoryops.apiUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL for the MemoryOps API."
        },
        "memoryops.workspaceId": {
          "type": "string",
          "default": "",
          "description": "MemoryOps workspace UUID."
        },
        "memoryops.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fallback MemoryOps workspace API key. **Prefer using the `MemoryOps: Set API Key (Secure)` command**, which stores the key in your OS keychain via VS Code SecretStorage. This setting is only used when no secure key is stored.",
          "deprecationMessage": "Use the secure 'MemoryOps: Set API Key (Secure)' command instead of setting a raw text key in settings.json to avoid leaking it in git repositories."
        },
        "memoryops.defaultTopK": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Default number of memories to request for search/retrieval commands."
        },
        "memoryops.defaultSearchMode": {
          "type": "string",
          "default": "hybrid",
          "enum": [
            "hybrid",
            "keyword",
            "vector"
          ],
          "description": "Default retrieval/search mode for MemoryOps commands."
        },
        "memoryops.defaultTokenBudget": {
          "type": "number",
          "default": 2048,
          "minimum": 256,
          "maximum": 16000,
          "description": "Default token budget for retrieval context requests."
        },
        "memoryops.sidebarPageSize": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of recent memories to load in the MemoryOps sidebar."
        },
        "memoryops.includeWorkspacePool": {
          "type": "boolean",
          "default": false,
          "description": "Include workspace-published memories when searching and retrieving context."
        },
        "memoryops.defaultAgentId": {
          "type": "string",
          "default": "vscode",
          "description": "Agent identifier used when saving observations from VS Code."
        },
        "memoryops.maxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of times to automatically retry read-only requests (search, retrieve, list, health) on transient failures (timeouts, network errors, 5xx/429). Set to 0 to disable retries."
        },
        "memoryops.retryBackoffMs": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 10000,
          "description": "Base delay in milliseconds for exponential backoff between retries. Each retry waits roughly base × 2^(attempt-1) with light jitter, capped at 8s."
        },
        "memoryops.enableCodeLens": {
          "type": "boolean",
          "default": false,
          "description": "Show an inline CodeLens at the top of files indicating how many MemoryOps memories reference the current file. Issues a (cached) search request per file."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "memoryops.chat",
        "name": "memoryops",
        "fullName": "MemoryOps",
        "description": "Query your MemoryOps workspace memories",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Search your MemoryOps workspace for matching memories"
          },
          {
            "name": "retrieve",
            "description": "Retrieve token-budgeted packed context for a prompt"
          }
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "memoryops.gettingStarted",
        "title": "Get Started with MemoryOps",
        "description": "Connect VS Code to your MemoryOps backend and start working with governed agent memory.",
        "steps": [
          {
            "id": "memoryops.configure",
            "title": "Connect your backend",
            "description": "Set your API URL and workspace ID.\n[Open MemoryOps Settings](command:memoryops.openSettings)",
            "media": {
              "markdown": "media/walkthroughs/configure.md"
            },
            "completionEvents": [
              "onSettingChanged:memoryops.workspaceId"
            ]
          },
          {
            "id": "memoryops.apiKey",
            "title": "Authenticate securely",
            "description": "Store your workspace API key in the OS keychain.\n[Set API Key (Secure)](command:memoryops.setApiKey)",
            "media": {
              "markdown": "media/walkthroughs/api-key.md"
            },
            "completionEvents": [
              "onCommand:memoryops.setApiKey"
            ]
          },
          {
            "id": "memoryops.testConnection",
            "title": "Verify the connection",
            "description": "Confirm the extension can reach and authenticate with your backend.\n[Test Connection](command:memoryops.testConnection)",
            "media": {
              "markdown": "media/walkthroughs/test-connection.md"
            },
            "completionEvents": [
              "onCommand:memoryops.testConnection"
            ]
          },
          {
            "id": "memoryops.explore",
            "title": "Start using your memories",
            "description": "Browse, search, capture, and retrieve memories.\n[Open MemoryOps View](command:workbench.view.extension.memoryops)",
            "media": {
              "markdown": "media/walkthroughs/explore.md"
            },
            "completionEvents": [
              "onCommand:memoryops.searchMemory",
              "onCommand:memoryops.refreshMemories"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/test/client.test.js out/test/markdown.test.js out/test/webviewProvider.test.js",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  }
}
