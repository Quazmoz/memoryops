FROM node:26-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# VITE_API_BASE_URL is baked in at build time (safe — it's a path, not a secret).
# VITE_MEMORYOPS_WORKSPACE_ID is kept as a dev fallback only; the production
# image uses the runtime /config.json generated by entrypoint.sh.
ARG VITE_API_BASE_URL=/api
ARG VITE_MEMORYOPS_WORKSPACE_ID
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_MEMORYOPS_WORKSPACE_ID=$VITE_MEMORYOPS_WORKSPACE_ID
RUN npx tsc -b && npx vite build

# Use the unprivileged nginx image so the container runs as uid 101 (nginx)
# rather than root.  Ports < 1024 require extra capability; we listen on 8080
# inside the container and remap at compose/k8s level.
FROM nginxinc/nginx-unprivileged:1.27-alpine

LABEL com.memoryops.nginx="8080-unprivileged"

# Allow the entrypoint script to write config.json into the served directory.
USER root
COPY --from=builder /app/dist /usr/share/nginx/html
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY entrypoint.sh /docker-entrypoint.d/10-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/10-runtime-config.sh \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && echo "MemoryOps frontend image configured for port 8080"
USER nginx

# nginxinc/nginx-unprivileged default port is 8080
EXPOSE 8080
# The unprivileged image already calls nginx via its own entrypoint.d mechanism;
# our script is dropped into /docker-entrypoint.d/ and runs before nginx starts.
