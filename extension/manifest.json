{
  "manifest_version": 3,
  "name": "MemoryOps",
  "version": "0.1.0",
  "description": "Capture and retrieve memories from MemoryOps directly from your browser.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MemoryOps"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
