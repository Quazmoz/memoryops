# MemoryOps Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit .env to source control.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://memoryops:memoryops@localhost:5432/memoryops

# Redis connection string
REDIS_URL=redis://localhost:6379

# Qdrant gRPC URL
QDRANT_URL=http://localhost:6334

# ── Application ─────────────────────────────────────────────────────────────

APP_HOST=0.0.0.0
APP_PORT=8080

# development | production
APP_ENV=development

# Path to TOML config file
CONFIG_PATH=config.toml

# ── Webhook Secrets ──────────────────────────────────────────────────────────
# Set these to the secrets you configure in GitHub / Slack app settings

# GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# SLACK_SIGNING_SECRET=your-slack-signing-secret

# ── AI Providers (optional — only needed if not using local defaults) ────────

# Required if embedding.provider = "openai" in config.toml
# OPENAI_API_KEY=sk-...

# Required if llm.provider = "anthropic" in config.toml
# ANTHROPIC_API_KEY=sk-ant-...

# ── Observability ────────────────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error
RUST_LOG=info

# OTEL exporter endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
